# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Node Environment
NODE_ENV=development

# Server Port (optional, defaults to 5000)
PORT=5000

# Gemini API (if using AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Origin
# Format: https://yourdomain.com (production) or http://localhost:3000 (development)
CORS_ORIGIN=https://smartquiz-frontend.vercel.app
